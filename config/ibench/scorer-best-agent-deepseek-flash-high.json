{
  "agents": [
    {
      "import_path": "ibench_best_agent:BestAgentCli",
      "model_name": "deepseek-v4-flash",
      "env": {
        "BEST_AGENT_CLI_VERSION": "0.0.19",
        "BEST_AGENT_CLI_WORKSPACE": "/workspace",
        "BEST_AGENT_CLI_COMMIT": "0",
        "BEST_AGENT_PROVIDER_MODEL": "deepseek-v4-flash",
        "BEST_AGENT_MODEL_TIMEOUT_MS": "600000",
        "BEST_AGENT_RUN_DURATION_MS": "3300000",
        "BEST_AGENT_GIT_IDENTITY_NAME": "ibench scorer",
        "BEST_AGENT_GIT_IDENTITY_EMAIL": "scorer@ibench.invalid",
        "BEST_AGENT_CLI_EXECUTION_ARGS_JSON": "[\"--workspace-backend\",\"plain\",\"--workspace-authorization\",\"unrestricted\",\"--command-policy\",\"path\",\"--process-isolation\",\"host\",\"--workspace-grant\",\"read\",\"--workspace-grant\",\"write\",\"--workspace-grant\",\"exec\",\"--tool-exclude\",\"network\"]"
      },
      "extra_allowed_hosts": ["dimagent.cn"],
      "override_setup_timeout_sec": 1800
    }
  ],
  "environment": { "type": "docker" },
  "n_concurrent_trials": 2,
  "retry": { "max_retries": 0 }
}
